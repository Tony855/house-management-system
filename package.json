{
  "name": "house-sys",
  "version": "1.0.0",
  "private": true,
  "description": "房屋管理系统（租房/酒店/物业模式），Node.js + Express + MariaDB",
  "main": "server/app.js",
  "scripts": {
    "start": "node server/app.js",
    "seed": "node server/seed.js",
    "test:db-mode": "node db/test_db_mode.js",
    "test:tenant-isolation": "node --test db/test_tenant_isolation.js db/test_tenant_provisioner.js",
    "test": "npm run test:db-mode && npm run test:tenant-isolation"
